<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 
        Minimale Berechtigungen für alle Android Versionen ab 10 (API 29)
        
        Benötigte Funktionalitäten:
        1. Notification Listener Service - zum Lesen von Notifications
        2. Audio Kontrolle - zum Ändern der Lautstärke
        3. Eigene Notifications senden
        4. Foreground Service für Dauerbetrieb
    -->
    
    <!-- Foreground Service für Notification Listener -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    
    <!-- Ändern der Audio-Lautstärke (für alle Android Versionen) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    
    <!-- Notifications senden (ab Android 13 benötigt, für ältere Versionen optional) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>


    <application
        android:name=".AdFreeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/adfree_logo"
        android:label="@string/app_name"
        android:screenOrientation="portrait"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning">


        <activity
            android:name="ch.abertschi.adfree.crashhandler.SendCrashReportActivity"
            android:process=":crashlog"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="stateHidden"
            android:exported="false">
            <intent-filter>
                <action android:name="ch.abertschi.adfree.SEND_LOG_CRASH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".view.mod.ActiveDetectorActivity"
            android:screenOrientation="portrait">
        </activity>

        <activity
                android:name=".view.mod.GenericTextDetectorActivity"
                android:screenOrientation="portrait">
        </activity>

        <activity
                android:name=".view.mod.CategoriesActivity"
                android:screenOrientation="portrait">
        </activity>

        <activity
            android:name=".view.mod.ModActivity"
            android:screenOrientation="portrait">
        </activity>

        <service android:name=".util.NotificationUtils$NotificationInteractionService"/>

        <!-- 
            Notification Listener Service
            BIND_NOTIFICATION_LISTENER_SERVICE wird automatisch als Service-Berechtigung benötigt
        -->
        <service
            android:name=".NotificationsListeners"
            android:label="audio ad blocker"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:foregroundServiceType="notificationListener"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
    </application>

</manifest>
